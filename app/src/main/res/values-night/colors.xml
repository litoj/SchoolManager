<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Night palette. Only the entries whose night value differs from the
         light one are listed; every other entry in values/colors.xml is shared.
         The app selects this file by the system dark setting (the theme is a
         DayNight one), and force dark stays off so it cannot re-tint these
         values on top. Two rules hold the palette together:
         - Every surface keeps its own text entry, so a dark surface never gets
           dark text: on the green header that is colorOnHeader (dark here), on
           the grey action strips colorActionText (light, from the light file).
         - The green header gets brighter here, which is what makes the dark
           on-header text readable on it. -->
    <color name="colorPrimaryFg">#DDFFFFFF</color>
    <color name="colorPrimaryBg">#FF1E1E1E</color>
    <color name="colorPrimaryHeader">#FF6EB31F</color>
    <!-- The drawer banner's light end (see values/colors.xml). -->
    <color name="colorHeaderSoft">#FF84BE41</color>
    <!-- The dark status band here too — the night primary green darkened, the way the
         light band darkens the light primary. White icons read on both. -->
    <color name="colorStatusBar">#FF4F8016</color>

    <color name="colorOnHeader">#DD000000</color>
    <color name="colorPositionText">#FFFFFFFF</color>
    <color name="colorDescText">#FF7FC63B</color>
    <!-- A lighter wash than the light palette's: on a dark surface the black
         one sinks into the list behind the strip. -->
    <color name="colorActionBar">#88555555</color>
    <!-- The app-bar query field is bare on the header, so its hint follows the
         dark on-header text. -->
    <color name="colorSearchHint">#B3000000</color>

    <color name="colorFailure">#FFFF5252</color>
    <color name="colorHighlight">#33FFFFFF</color>
    <color name="colorSelectedRow">#406EB31F</color>
    <color name="colorMenuBackground">#FF303030</color>
</resources>
