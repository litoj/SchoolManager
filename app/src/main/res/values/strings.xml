    <string name="help_search">Searching</string>
    <string name="help_search_hint">Search help</string>
    <string name="help_search_how">Search finds names and translations in the open set.
        \nThe filter icon builds a query from labeled choices, so the prefix syntax stays optional.
        \nA word hit shows its translations directly, a settings toggle turns that off.
        \nA settings switch turns on diacritic-insensitive search.</string>
    <string name="help_search_filter">Filter</string>
    <string name="help_search_filter_how">Pick the type, what to compare and the condition, then enter a value.
        \nThe preview shows the written query before it runs.
        \nApply writes it into the field and starts the search.</string>
    <string name="help_search_advanced">Written query</string>
    <string name="help_search_advanced_how">The field accepts the written form the filter builds.
        \nA regular expression follows Java syntax.</string>
    <string name="help_search_advanced_examples" formatted="false">\WR>50\t- words with success rate above 50%
        \n\sD\t- names starting with \'D\'
        \n\WD\hund\t- words whose description contains \'hund\'</string>
    <string name="help_select">Editing</string>
    <string name="help_select_delete">Deletes the selected items after the confirmation.</string>
    <string name="help_select_edit">Edit opens the single selected item. OK saves the changes.</string>
    <string name="help_select_how">Long-press the first row starts a selection. A tap on the type icon toggles a row while it runs.
        \nDrag across rows to select a range. The top-right check selects all or ends the selection. Back ends it too.</string>
    <string name="help_select_move">Cut takes the selected rows and shows the paste strip. Open the target and press Paste.
        \nThe armed move survives a chapter switch.</string>
    <string name="help_test">Tests</string>
    <string name="help_test_how">The test asks for the words of the picked sources.</string>
    <string name="help_test_results">Test results</string>
    <string name="help_test_results_how">The report opens when you press Done or the time runs out.
        \nThe title is the score. Every row is one tested word, including words with variants.
        \nA synonym counts separately.
        \nThe large text is the prompt, below it the correct answer and yours.
        \nThe number with × counts how often the word was tested.
        \nThe right end shows passed over tested, and all counts include this test.
        \nRetake runs a new test on the same sources.</string>
    <string name="help_test_run">Test progress</string>
    <string name="help_test_run_how">Start needs at least one source. Each word is asked once in a shuffled order.
        \nWords with the exact same translation set share one prompt. A repeated answer passes only once.
        \nThe countdown blinks red for the last 30 seconds.
        \nRequiring name variants adds one answer field per alternative and scales time by 1.5 per added variant.
        \nThe prompt shows the first line of the word\'s description.
        \nDone submits and asks first when answers are missing. QUIT or Back ends without grading.</string>
    <string name="help_test_select">Selecting items for the test</string>
    <string name="help_test_select_how">Add source opens the picker. Long-press a row or tap its type icon to pick it, then Select.
        \nAll sources must belong to one set.</string>
