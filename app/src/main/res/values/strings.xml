    <string name="help_search">Searching</string>
    <string name="help_search_hint">Search help</string>
    <string name="help_search_how">Search finds names and translations in the open subject.
        \nThe filter icon beside sort adds a filter, the chips under the header name the ones a search runs with.
        \nA chip label opens its filter again, its mark drops it.
        \nA search answers to its text and to every filter together.
        \nA word result shows its translations directly, a settings toggle turns that off.
        \nA search started while rows are selected reads those rows and their content only.
        \nA settings switch turns on diacritic-insensitive search.</string>
    <string name="help_select">Editing</string>
    <string name="help_select_delete">Deletes the selected items after the confirmation.</string>
    <string name="help_select_edit">Edit opens the single selected item. OK saves the changes.</string>
    <string name="help_select_how">Long-press the first row starts a selection. A tap on the type icon toggles a row while it runs.
        \nA drag from an unselected row selects a range.
        \nA drag of a selected row moves it where the list has an order.
        \nThe top-right check selects all or ends the selection. Back ends it too.</string>
    <string name="help_select_move">Cut takes the selected rows and shows the paste strip. Open the target and press Paste.
        \nThe armed move survives a chapter switch.
        \nA long press or the row icon in any chapter adds a row to the move or takes it out, and Add reference works the same.</string>
    <string name="help_test">Tests</string>
    <string name="help_test_how">The test asks for the words of the picked sources.</string>
    <string name="help_test_results">Test results</string>
    <string name="test_results_help_band">The band on the left matches the count on the right.
        \nHalf right paints it yellow, a worse score redder, a better one greener.
        \nIt counts every test, not just this one.</string>
    <string name="test_results_help_low">often wrong</string>
    <string name="test_results_help_mid">half right</string>
    <string name="test_results_help_high">always right</string>
    <string name="test_results_help_marks">Green letters match, gray fills what you left out, red is extra.</string>
    <string name="test_results_help_answer">alwayz right</string>
    <string name="test_results_help_target">always right</string>
    <string name="help_test_run">Test progress</string>
    <string name="help_test_run_how">Start needs at least one source. Each word is asked once in a shuffled order.
        \nWords with the exact same translation set share one prompt. A repeated answer passes only once.
        \nEvery synonym is graded on its own.
        \nThe countdown blinks red for the last 30 seconds.
        \nEach word gets 5 seconds plus its answer length times the seconds per character.
        \nRequiring name variants adds one answer field per alternative and scales time by 1.5 per added variant.
        \nThe prompt shows the first line of the word\'s description.
        \nDone submits and asks first when answers are missing. ABORT or Back ends without grading.
        \nDone or the timeout opens the report, where Retake runs a new test on the same sources.</string>
    <string name="help_test_select">Selecting items for the test</string>
    <string name="help_test_select_how">Add source opens the picker. Long-press a row or tap its type icon to pick it, then Select.
        \nAll sources must belong to one subject.</string>
