    <string name="help">Help</string>
    <string name="help_create">Creating items</string>
    <string name="help_create_ch">Chapters</string>
    <string name="help_create_how">The New button offers the types of the open screen. A tap leaves the palette standing, a drag picks at once.
        \nThe button hides while the list scrolls down.
        \nThe creator fields are name, description and, for a word, its translations.</string>
    <string name="help_create_mch">Sets</string>
    <string name="help_create_note">Notes</string>
    <string name="help_create_note_how">Notes carry a name and a description, and serve for any text that is not a word, like a grammar rule.
        \nA tap on a note copies its text.</string>
    <string name="help_create_word">Words</string>
    <string name="help_create_word_how">The add icon below the fields adds a translation.
        \nA translation has a name and an optional description.
        \nThe cancel icon removes it.</string>
    <string name="help_extra">More useful functions</string>
    <string name="help_extra_how">A few features are easier to miss. Here they are.</string>
    <string name="help_extra_naming">Name variants</string>
    <string name="help_extra_naming_how">A slash offers two name variants, parentheses group a whole variant.
        \nThe word and its translations can use them.</string>
    <string name="help_extra_naming_examples">I/They come = \'I come\' or \'They come\'
        \n(I go)/(He goes). = \'I go.\' or \'He goes\'.</string>
    <string name="help_extra_words_export">Export items</string>
    <string name="help_extra_words_export_how">The menu shows Export only while rows are selected.\nThe export reaches every selected row except translations.\nWord file: compact, no success rates, no references.\nJSON file: complete, success rates, notes and references included.</string>
    <string name="help_extra_words_import">Import items</string>
    <string name="help_extra_words_import_how">Inside a set the words land in it, at the sets screen a new set is created.\nAn error names the file and line. Fix that line and pick the file again.</string>
    <string name="help_import_format">File format</string>
    <string name="help_import_format_body">Chapter: name { and } on their own lines.
        \nWord: word = translation.
        \nNote: = text.
        \nDescription: [text] after a name.
        \nVariants: first\\second.
        \n\nKapitel 1 {
        \n\tder Hund = pes
        \n\tdie Katze = kočka
        \n}</string>
