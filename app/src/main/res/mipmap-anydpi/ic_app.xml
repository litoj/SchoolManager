<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon: with a legacy drawable the launcher paints its own plate behind
     the glyph, which goes dark in dark mode — and a transparent background layer
     composites to pure black on launchers that flatten the icon to a bitmap, so
     the background is white. minSdk 30 is past 26, so no -v26 qualifier is needed.
     The monochrome layer serves Android 13+ themed icons. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@android:color/white" />
    <foreground android:drawable="@drawable/ic_app_foreground" />
    <monochrome android:drawable="@drawable/ic_app_foreground" />
</adaptive-icon>
