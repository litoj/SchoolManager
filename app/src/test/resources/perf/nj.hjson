            {
              name: Der Topf liegt auf dem Tisch.
              translations:
              [
                {
                  name: Hrnec leží na stole.
                }
              ]
            }
            {
              name: Neben den Tellern steht die Gläser.
              translations:
              [
                {
                  name: Vedle talířů stojí skleničky.
                }
              ]
            }
            {
              name: Sehen Sie sich die Fotos an.
              translations:
              [
                {
                  name: Podívejte se na ty fotky.
                }
              ]
            }
            {
              name: Was ist hier los?
              translations:
              [
                {
                  name: Co se tady děje?
                }
              ]
            }
            {
              name: Ich muss mich schnell umziehen.
              translations:
              [
                {
                  name: Musím se rychle převléknout.
                }
              ]
