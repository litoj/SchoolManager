                }
              ]
            }
            {
              name: Der Kühlschrank ist leer.
              translations:
              [
                {
                  name: Lednička je prázdná.
                }
              ]
            }
            {
              name: Das ist mir jetzt echt peinlich.
              translations:
              [
                {
                  name: To je mi teď fakt trapné.
                }
              ]
            }
            {
              name: Was ist los?
              translations:
