            }
            {
              name: müde sein
              translations:
              [
                {
                  name: být unavený
                }
              ]
            }
            {
              name: Das macht keinen Spaß.
              translations:
              [
                {
                  name: To není zábava.
                }
              ]
            }
            {
              name: Ich habe keinen Stift.
              translations:
              [
                {
                  name: Nemám tužku.
                }
              ]
            }
            {
              name: Sie haben keine Zeit.
              translations:
              [
                {
                  name: Nemají čas.
                }
