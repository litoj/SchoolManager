	{"class": "objects.Chapter", "name": "21.9.", "cdrn": [
		{"class": "objects.Word", "name": "Der Topf liegt auf dem Tisch.", "cdrn": [
			{"name": "Hrnec leží na stole."}
		]},
		{"class": "objects.Word", "name": "Neben den Tellern steht die Gläser.", "cdrn": [
			{"name": "Vedle talířů stojí skleničky."}
		]},
		{"class": "objects.Word", "name": "Sehen Sie sich die Fotos an.", "cdrn": [
			{"name": "Podívejte se na ty fotky."}
		]},
		{"class": "objects.Word", "name": "Was ist hier los?", "cdrn": [
			{"name": "Co se tady děje?"}
		]},
		{"class": "objects.Word", "name": "Ich muss mich schnell umziehen.", "cdrn": [
			{"name": "Musím se rychle převléknout."}
		]},
		{"class": "objects.Word", "name": "Freust du dich schon?", "cdrn": [
			{"name": "Už se tešíš?"}
		]},
		{"class": "objects.Word", "name": "Er beeilt sich so?", "cdrn": [
			{"name": "On tak pospíchá?"}
		]},
		{"class": "objects.Word", "name": "Wir ärgern uns nicht oft?", "cdrn": [
			{"name": "Nerozčilujeme se často?"}
		]},
		{"class": "objects.Word", "name": "Setzt euch aufs Sofa.", "cdrn": [
			{"name": "Sedněte si na pohovku."}
		]},
		{"class": "objects.Word", "name": "Sie regen sich immer auf.", "cdrn": [
			{"name": "Pořád se rozčilují."}
		]},
		{"class": "objects.Word", "name": "Na, alles klar bei dir?", "cdrn": [
			{"name": "Čau, jak je?"}
		]},
		{"class": "objects.Word", "name": "nix/nichts", "cdrn": [
			{"name": "nic"}
		]},
		{"class": "objects.Word", "name": "Kopf hoch.", "cdrn": [
			{"name": "Hlavu vzhůru."}
		]},
		{"class": "objects.Word", "name": "sich langweilen", "cdrn": [
			{"name": "nudit se"}
		]},
		{"class": "objects.Word", "name": "sich treffen", "cdrn": [
			{"name": "potkat se"}
		]},
		{"class": "objects.Word", "name": "die Bohnen", "cdrn": [
			{"name": "fazole"}
		]},
		{"class": "objects.Word", "name": "den Fernseher anmachen", "cdrn": [
			{"name": "zapnout televizi"}
		]},
		{"class": "objects.Word", "name": "Ich bin schon unterwegs.", "cdrn": [
			{"name": "Už jsem na cestě."}
		]},
		{"class": "objects.Word", "name": "Er schaut auf die Uhr.", "cdrn": [
			{"name": "Dívá se na hodinky."}
		]}
	]},
	{"class": "objects.Chapter", "name": "25.9.", "cdrn": [
		{"class": "objects.Word", "name": "Hast du schon Geschirr gespült?", "cdrn": [
			{"name": "Už jsi umyl nádobí?"}
		]},
		{"class": "objects.Word", "name": "Ich putze dreimal pro Woche.", "cdrn": [
			{"name": "Čistím třikrát týdně."}
		]},
		{"class": "objects.Word", "name": "Ich habe mich ausgeruht.", "cdrn": [
			{"name": "Odpočinul jsem si."}
		]},
		{"class": "objects.Word", "name": "Sie hat noch nicht eingekauft.", "cdrn": [
			{"name": "Ješte nenakoupila."}
		]},
		{"class": "objects.Word", "name": "Hast du den Film schon gesehen?", "cdrn": [
			{"name": "Už jsi viděl ten film?"}
		]},
		{"class": "objects.Word", "name": "Warum hast du dich nicht gemeldet?", "cdrn": [
			{"name": "Proč jsi se neozval?"}
		]},
		{"class": "objects.Word", "name": "wahrscheinlich", "cdrn": [
			{"name": "pravděpodobně"}
		]},
		{"class": "objects.Word", "name": "eigentlich", "cdrn": [
			{"name": "vlastně"}
		]},
		{"class": "objects.Word", "name": "Er hat mich zum Essen eingeladen.", "cdrn": [
			{"name": "Pozval mě na jídlo."}
		]},
		{"class": "objects.Word", "name": "Wir haben das Zimmer schnell aufgeräumt.", "cdrn": [
			{"name": "Pokoj jsme rychle uklidili."}
		]},
		{"class": "objects.Word", "name": "mit der Straßenbahn fahren", "cdrn": [
			{"name": "jet tramvají"}
		]}
	]}
